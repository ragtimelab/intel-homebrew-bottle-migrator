#!/bin/zsh

set -u
[[ -n "${IHBM_CALL_LOG:-}" ]] && print -r -- "port ${(j: :)@}" >> "$IHBM_CALL_LOG"

if [[ "$1" == version ]]; then
  print -r -- 'Version: 2.12.6'
  exit 0
fi
if [[ "$1" == info ]]; then
  if [[ "$2" == --version ]]; then
    case "${@: -1}" in
      gh) print -r -- "${IHBM_PORT_VERSION:-2.98.0}" ;;
      ImageMagick7) print -r -- "${IHBM_PORT_VERSION:-7.1.2-30}" ;;
      giflib) print -r -- '4.2.3' ;;
      noarch) print -r -- '1.0.0' ;;
      *) print -r -- "${IHBM_PORT_VERSION:-15.1.0}" ;;
    esac
  elif [[ "$2" == --revision ]]; then
    [[ "${@: -1}" == giflib ]] && print -r -- '1' || print -r -- '0'
  elif [[ "$2" == --name ]]; then
    print -r -- "${@: -1}"
  else
    print -r -- "${IHBM_PORT_VERSION:-15.1.0}"
  fi
  exit 0
fi
if [[ "$1" == variants ]]; then
  if [[ "${@: -1}" == gh || "${@: -1}" == noarch ]]; then
    print -r -- 'gh has no variants'
  elif [[ "${@: -1}" == ImageMagick7 ]]; then
    print -r -- 'ImageMagick7 has the variants:'
    print -r -- '[+]openexr: Support OpenEXR'
    print -r -- '[+]x11: Enable X11 support'
  elif [[ "${@: -1}" == giflib ]]; then
    print -r -- 'giflib has the variants:'
    print -r -- '   highdepth: Enable high-bit-depth encoding'
    print -r -- '   x11: Include gif2x11 tool'
  else
    print -r -- 'ripgrep has the variants:'
    print -r -- '[+]pcre: Build with pcre2'
  fi
  exit 0
fi
if [[ "$1" == installed ]]; then
  print -r -- 'The following ports are currently installed:'
  if [[ "${IHBM_PORT_INACTIVE:-0}" != 1 ]]; then
    if [[ "${@: -1}" == gh ]]; then
      print -r -- "  gh @${IHBM_PORT_VERSION:-2.98.0}_0 (active)"
    elif [[ "${@: -1}" == ImageMagick7 ]]; then
      print -r -- "  ImageMagick7 @${IHBM_PORT_VERSION:-7.1.2-30}_0+openexr+x11 (active)"
    elif [[ "${@: -1}" == noarch ]]; then
      print -r -- '  noarch @1.0.0_0 (active)'
    else
      print -r -- "  ripgrep @${IHBM_PORT_VERSION:-15.1.0}_0+pcre (active)"
    fi
  fi
  exit 0
fi
if [[ "$1" == echo && "$2" == requested ]]; then
  print -r -- 'ripgrep @15.1.0_0+pcre'
  print -r -- 'gh @2.98.0_0'
  exit 0
fi
if [[ "$1" == contents ]]; then
  if [[ "${@: -1}" == gh ]]; then
    print -r -- 'Port gh contains:'
    print -r -- "  ${IHBM_FIXTURE_ROOT}/opt/local/bin/gh"
  elif [[ "${@: -1}" == ImageMagick7 ]]; then
    print -r -- 'Port ImageMagick7 contains:'
    print -r -- "  ${IHBM_FIXTURE_ROOT}/opt/local/lib/ImageMagick7/bin/magick"
  else
    print -r -- 'Port ripgrep contains:'
    print -r -- "  ${IHBM_FIXTURE_ROOT}/opt/local/bin/rg"
  fi
  exit 0
fi
if [[ "$1" == -b && "$2" == -y && "$3" == install ]]; then
  if [[ "${IHBM_LARGE_PLAN:-0}" == 1 ]]; then
    /usr/bin/awk 'BEGIN { for (i=0;i<40000;i++) printf "x"; printf "\n" }'
  else
    if [[ "${IHBM_CLOSURE_PLAN:-0}" == 1 ]]; then
      print -r -- '--->  Dependencies to be installed: noarch'
    elif [[ "${IHBM_CLOSURE_PLAN:-0}" == propagated ]]; then
      print -r -- '--->  Dependencies to be installed: giflib'
    fi
    print -r -- 'Would install requested ports from binary archives'
  fi
  exit 0
fi
print -u2 -- "unsupported fixture port command: ${(j: :)@}"
exit 64
